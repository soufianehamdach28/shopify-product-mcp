# Optional default store. The web UI lets visitors enter any store domain,
# and MCP tools accept a `store` argument, so this is only a fallback.
# STORE_DOMAIN=your-store.myshopify.com

# Web server bind address and port.
HOST=127.0.0.1
PORT=3000

# Restrict which store domains the server may fetch. Recommended when the
# app is reachable from the internet. Comma-separated hostnames; wildcard
# entries like *.myshopify.com are supported. When unset, any valid public
# domain is allowed (IPs, localhost, and reserved hosts are always rejected).
# ALLOWED_STORE_HOSTS=your-store.myshopify.com,www.your-store.com

# For deployment behind a proxy, set the public hostname(s) and origin(s).
# Comma-separated, without scheme or port.
# ALLOWED_HOSTS=shop.example.com
# ALLOWED_ORIGINS=shop.example.com

# Docker Compose / Oracle Cloud: the public IP or hostname users will visit.
# Omit http:// and the port. For an IPv4 address, use just the address.
# docker-compose.yml derives ALLOWED_HOSTS and ALLOWED_ORIGINS from this.
# PUBLIC_HOST=203.0.113.10
# PUBLIC_PORT=3000

# Optional bearer token required on the /mcp endpoint.
# Generate one with: openssl rand -hex 32
# MCP_AUTH_TOKEN=
